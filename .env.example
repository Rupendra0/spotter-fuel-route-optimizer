# Spotter Fuel Route Optimizer Configuration
DEBUG=True
SECRET_KEY=django-insecure-spotter-route-optimizer-eval-key-2026-xyz
ALLOWED_HOSTS=*

# External API Configurations (Free / OpenStreetMap endpoints)
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving/
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=SpotterFuelOptimizer/1.0 (hiring-assessment)

# Route & Vehicle Constraints
